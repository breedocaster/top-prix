## Topic dictionary by id ({} if unknown).
static func topic(id: String) -> Dictionary:
	for t in TOPICS:
		if t.id == id: return t
	return {}

## Best topic for a bench tab / carb kind.
static func for_bench(tab: String, carb_kind := "") -> String:
	match tab:
		"efi": return "efi"
		"dyno": return "dyno"
		"setup": return "setup"
		"sync": return "sync"
	match carb_kind:
		"down": return "carb_down"
		"side": return "carb_side"
	return "carb_slide"
